# ============================================
# Moodle Docker Configuration
# ============================================
# For development, use: docker-compose -f docker-compose.dev.yml --env-file .env.dev up
# For production, update these values with secure credentials

# Application
APP_PORT=8080
WWWROOT=http://localhost:8080

# Database Configuration (MariaDB 11.8 LTS)
DB_TYPE=mariadb
DB_HOST=db
DB_PORT=3306
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=changeme_secure_password
DB_ROOT_PASSWORD=changeme_root_password
DB_PREFIX=mdl_
DB_EXTERNAL_PORT=3306

# Moodle Admin
ADMIN_USER=admin
ADMIN_PASSWORD=changeme_admin_password
ADMIN_EMAIL=admin@example.com

# PHP Settings
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
